AI_MODE=mock
MODEL_PROVIDER=gemini
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=
CODE_EXECUTION_MODE=local
MAX_CODE_EXECUTION_SECONDS=20
MAX_UPLOAD_MB=20
MAX_OUTPUT_TOKENS=256

# LLM-based agent routing (AgentRegistry.select_llm, app/agents.py) —
# replaces pure keyword matching as the primary router for agent-mode turns.
# Requires GEMINI_API_KEY above regardless of MODEL_PROVIDER (routing always
# calls Gemini directly — see app/config.py's comment). Falls back to
# keyword matching if GEMINI_API_KEY is unset, the call fails/rate-limits,
# or the model's response can't be parsed — routing never breaks chat.
# AGENT_ROUTER_MODEL=gemma-4-26b-a4b-it     # default — smallest/fastest Gemma 4
# AGENT_ROUTER_MODEL=gemma-4-31b-it         # larger Gemma 4, stronger reasoning
# AGENT_ROUTER_MODEL=gemini-3.1-flash-lite  # non-reasoning-forced, faster/lower-latency,
#                                            # published free-tier rate limits

# MCP tool servers (see docs/tools.md) — both optional.
# MCP_STDIO_ENABLED=true
# MCP_STDIO_COMMAND=python
# MCP_STDIO_ARGS=mcp_servers/general_tools_server.py
# MCP_REMOTE_URL=
# MCP_REMOTE_TRANSPORT=streamable-http
# MCP_REMOTE_HEADERS=Authorization: Bearer <token>

# Tavily web search tool (https://tavily.com) — optional. Unset = the "Web
# Search" toggle in the UI stays available but every search attempt reports
# it isn't configured; no MCP tool is registered.
# TAVILY_API_KEY=tvly-...

# Langfuse observability (see docs/observability.md) — optional, unset = disabled.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://cloud.langfuse.com  # https://us.cloud.langfuse.com for a US-region account
