# Copy this file to .env for local development, or use it as the checklist
# for what to enter into Render's (or any host's) Environment tab when
# deploying — this file itself is never read by the app or committed with
# real values; it's a template only. See mcp_servers/README.md for the
# separate MCP tool server's own (much shorter) env var list.

# --- Core model / execution ---------------------------------------------------
AI_MODE=mock
MODEL_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=
OLLAMA_API_KEY=

# Azure AI Foundry (MODEL_PROVIDER=azure) — classic Azure OpenAI resource
# shape. AZURE_AI_ENDPOINT is the resource's base URL only, e.g.
# https://<resource>.openai.azure.com — never include "/openai/deployments/..."
# or "/openai/v1" (a common copy-paste mistake from the Azure portal's own
# endpoint field, which shows the newer unified-inference URL — this app
# builds the classic per-deployment path itself). AZURE_AI_DEPLOYMENT is the
# DEFAULT reasoning/chat deployment NAME you created inside that resource
# (Azure's "which model" is a deployment, not a public model id) — used
# everywhere MODEL_PROVIDER=azure is active (chat, skill drafting, turn
# routing), and required for the streaming/tool-calling path too.
# AZURE_AI_DEPLOYMENTS is every reasoning deployment this resource has,
# comma-separated, INCLUDING the default above — the Copilot model picker
# offers all of them (empty = just the one default, the common case).
# AZURE_AI_EMBEDDING_DEPLOYMENT is the (single) embedding deployment name for
# RAG — mirrors GEMINI_EMBEDDING_MODEL/OLLAMA_EMBEDDING_MODEL, no per-call
# picker. AZURE_AI_API_VERSION follows Azure's own dated versioning (e.g.
# 2024-10-21, 2024-08-01-preview) — only override if your resource needs a
# different one than the default baked into app/config.py. NOTE: switching
# MODEL_PROVIDER to/from azure changes which embedder RAG uses — an existing
# Qdrant collection sized for a different provider's embedding dimension will
# reject every query with a dimension-mismatch error until it's re-indexed
# (see docs/rag.md).
# AZURE_AI_ENDPOINT=https://<resource>.openai.azure.com
# AZURE_AI_API_KEY=
# AZURE_AI_DEPLOYMENT=
# AZURE_AI_DEPLOYMENTS=
# AZURE_AI_EMBEDDING_DEPLOYMENT=
# AZURE_AI_API_VERSION=2024-10-21

# "local": subprocess of this app's own process — dev-only, no real
# isolation (see app/sandbox.py). "e2b": routes to a real isolated micro-VM
# via the E2B API — required E2B_SANDBOX below. Use "e2b" for any real
# deployment (Render's own container has no isolation guarantee for
# "local"); "local" is fine for local dev only. "disabled" turns code
# execution off entirely.
CODE_EXECUTION_MODE=local
MAX_CODE_EXECUTION_SECONDS=20
MAX_UPLOAD_MB=20
MAX_OUTPUT_TOKENS=256

# E2B (https://e2b.dev/dashboard?tab=keys) — required only when
# CODE_EXECUTION_MODE=e2b.
# E2B_SANDBOX=e2b_...

# --- LLM-based agent routing (AgentRegistry.select_llm, app/agents.py) --------
# Requires GEMINI_API_KEY above regardless of MODEL_PROVIDER (routing always
# calls Gemini directly). Falls back to keyword matching if unset/unreachable.
# AGENT_ROUTER_MODEL=gemma-4-26b-a4b-it     # default — smallest/fastest Gemma 4
# AGENT_ROUTER_MODEL=gemma-4-31b-it         # larger Gemma 4, stronger reasoning
# AGENT_ROUTER_MODEL=gemini-3.1-flash-lite  # non-reasoning-forced, faster/lower-latency

# --- MCP tool servers (see mcp_servers/README.md) -----------------------------
# Stdio: the zero-config local-dev default — spawns mcp_servers/general_tools_server.py
# as a subprocess. Fine for local dev; NOT usable on a host like Render with
# no persistent local filesystem process model for this — use MCP_REMOTE_*
# instead once mcp_servers/hosted_tools_server.py is deployed as its own service.
# MCP_STDIO_ENABLED=true
# MCP_STDIO_COMMAND=python
# MCP_STDIO_ARGS=mcp_servers/general_tools_server.py

# Remote: point at a deployed mcp_servers/hosted_tools_server.py instance —
# this is what a Render deployment of the main app should set.
# MCP_REMOTE_URL=https://your-mcp-service.onrender.com/mcp
# MCP_REMOTE_TRANSPORT=streamable-http
# MCP_REMOTE_HEADERS=Authorization: Bearer <token>

# Tavily web search — only needed here if still using MCP_STDIO_ENABLED
# locally. Once MCP_REMOTE_URL points at a deployed hosted_tools_server.py,
# the Tavily key lives THERE (that service's own env), not here — see
# mcp_servers/README.md's secrets-boundary note.
# TAVILY_API_KEY=tvly-...

# --- RAG / vector store (see docs/rag.md) -------------------------------------
# Unset = RAGStore's in-memory fallback (exhaustive cosine scan) — no
# behavior change, no network dependency. Both URL and key must be set to
# use Qdrant Cloud.
# QDRANT_URL=https://xxxxxxxx.us-east4-0.gcp.cloud.qdrant.io
# QDRANT_API_KEY=
# QDRANT_COLLECTION=enterprise_copilot_chunks

# --- Observability (see docs/observability.md) --------------------------------
# Unset = disabled, no behavior change. See also app/db/models.py's
# guardrail_events/traces/model_calls tables — a local mirror of this data
# that's always recorded regardless of whether Langfuse is configured.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://cloud.langfuse.com  # https://us.cloud.langfuse.com for a US-region account

# --- Database (Postgres — required) -------------------------------------------
# Azure PostgreSQL Flexible Server, Neon, or any vanilla Postgres — reached
# through postgresql+asyncpg://. REQUIRED: the app fails to start its
# DB-backed features (auth, guardrail/trace/cost logging) without this, though
# chat itself still works if this is unset (see app/services.py's
# CopilotService.__init__ — DATABASE_URL is optional-but-recommended there).
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname

# --- Auth (JWT — required if you want login to work) --------------------------
# No default: a blank/guessable secret would let anyone forge a token for
# any user/tenant. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# JWT_SECRET_KEY=
# JWT_EXPIRE_MINUTES=15
# REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Session / chat-history store (Upstash Redis — required for chat) --------
# Reached over Upstash's HTTPS REST API (not a redis:// connection string) —
# see app/session_store.py. Get these from the Upstash console (REST API tab).
# UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
# UPSTASH_REDIS_REST_TOKEN=

# --- Blob storage (Backblaze B2 — required for document/skill-run content) ---
# S3-compatible; document raw text and skill-run output files live here
# (metadata stays in Postgres) — see app/blob_store.py.
# B2_ENDPOINT=https://s3.us-east-005.backblazeb2.com
# B2_BUCKET_NAME=
# B2_KEY_ID=
# B2_APPLICATION_KEY=
